{% comment %}
  Tangbuy / 60s — BYOB slot picker (multi-line cart).
  Metafield: tangbuy_byob.rule (slots with poolProductIds / poolProducts).
  No parent SKU — each pick is a separate cart line for normal sourcing.
{% endcomment %}

{% liquid
  assign rule = product.metafields.tangbuy_byob.rule.value
  assign slots = rule.slots
  assign label = rule.label
  if label == blank
    assign label = block.settings.heading
  endif
  if label == blank
    assign label = 'blocks.byob_builder.heading' | t
  endif
  assign status = rule.status | default: 'DRAFT'
  assign show = false
  if slots != blank and status == 'ACTIVE'
    assign show = true
  endif
%}

{% if show %}
  <div
    class="tb-byob"
    {{ block.shopify_attributes }}
    style="
      margin-top: {{ block.settings.margin_top }}px;
      margin-bottom: {{ block.settings.margin_bottom }}px;
    "
    data-tb-byob
  >
    <p class="tb-byob__eyebrow">{{ 'blocks.byob_builder.eyebrow' | t }}</p>
    <p class="tb-byob__heading">{{ label | escape }}</p>
    <p class="tb-byob__hint">{{ 'blocks.byob_builder.hint' | t }}</p>

    {% for slot in slots %}
      {% liquid
        assign slot_title = slot.title
        if slot_title == blank
          assign slot_title = slot.role
        endif
        assign pool_ids = slot.poolProductIds
        assign pool_products = slot.poolProducts
        assign min_n = slot.min | default: 0
        assign max_n = slot.max | default: 1
      %}
      <div
        class="tb-byob__slot"
        data-tb-byob-slot
        data-slot-id="{{ slot.id | escape }}"
        data-title="{{ slot_title | escape }}"
        data-min="{{ min_n }}"
        data-max="{{ max_n }}"
      >
        <div class="tb-byob__slot-head">
          <span class="tb-byob__slot-title">{{ slot_title | escape }}</span>
          <span class="tb-byob__slot-meta">{{ min_n }}–{{ max_n }}</span>
        </div>

        <ul class="tb-byob__pool">
          {% if pool_products != blank %}
            {% for item in pool_products %}
              {% assign handle = item.handle %}
              {% assign vid = item.variantId %}
              {% assign ptitle = item.title %}
              {% if handle != blank and all_products[handle] != blank %}
                {% assign p = all_products[handle] %}
                {% assign ptitle = p.title %}
                {% if vid == blank and p.selected_or_first_available_variant %}
                  {% assign vid = p.selected_or_first_available_variant.id %}
                {% endif %}
                {% if vid != blank %}
                  <li class="tb-byob__pool-item">
                    <span class="tb-byob__pool-name">{{ ptitle | escape }}</span>
                    <label class="tb-byob__qty">
                      <span class="visually-hidden">Qty</span>
                      <input
                        type="number"
                        min="0"
                        max="{{ max_n }}"
                        value="0"
                        data-tb-byob-pick
                        data-variant-id="{{ vid }}"
                      >
                    </label>
                  </li>
                {% else %}
                  <li class="tb-byob__pool-item tb-byob__pool-item--muted">
                    <span>{{ ptitle | escape }}</span>
                    <span>{{ 'blocks.byob_builder.unavailable' | t }}</span>
                  </li>
                {% endif %}
              {% elsif vid != blank %}
                <li class="tb-byob__pool-item">
                  <span class="tb-byob__pool-name">{{ ptitle | default: item.id | escape }}</span>
                  <label class="tb-byob__qty">
                    <input
                      type="number"
                      min="0"
                      max="{{ max_n }}"
                      value="0"
                      data-tb-byob-pick
                      data-variant-id="{{ vid }}"
                    >
                  </label>
                </li>
              {% else %}
                <li class="tb-byob__pool-item tb-byob__pool-item--id">
                  <span>{{ 'blocks.byob_builder.product_id' | t: id: item.id }}</span>
                </li>
              {% endif %}
            {% endfor %}
          {% elsif pool_ids != blank %}
            {% for pid in pool_ids %}
              {% assign pid_s = pid | append: '' %}
              {% assign current_id = product.id | append: '' %}
              {% if pid_s == current_id and product.selected_or_first_available_variant %}
                <li class="tb-byob__pool-item">
                  <span class="tb-byob__pool-name">{{ product.title | escape }}</span>
                  <label class="tb-byob__qty">
                    <input
                      type="number"
                      min="0"
                      max="{{ max_n }}"
                      value="0"
                      data-tb-byob-pick
                      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                    >
                  </label>
                </li>
              {% else %}
                <li class="tb-byob__pool-item tb-byob__pool-item--id">
                  <span>{{ 'blocks.byob_builder.product_id' | t: id: pid }}</span>
                </li>
              {% endif %}
            {% endfor %}
          {% else %}
            <li>
              <p class="tb-byob__empty">{{ 'blocks.byob_builder.empty_slot' | t }}</p>
            </li>
          {% endif %}
        </ul>
      </div>
    {% endfor %}

    <div class="tb-byob__footer">
      <p
        class="tb-byob__status"
        data-tb-byob-status
        data-ok="{{ 'blocks.byob_builder.ready' | t }}"
        data-added="{{ 'blocks.byob_builder.added' | t }}"
        data-err="{{ 'blocks.byob_builder.add_error' | t }}"
      ></p>
      <button type="button" class="tb-byob__btn tb-byob__btn--primary" data-tb-byob-add>
        {{ 'blocks.byob_builder.add_bundle' | t }}
      </button>
    </div>
  </div>

  <script src="{{ 'byob-builder.js' | asset_url }}" defer></script>

  {% style %}
    .tb-byob {
      --tb-fg: #1a1a1a;
      --tb-mute: #6b7280;
      --tb-border: #e5e7eb;
      --tb-soft: #f3f4f6;
      --tb-accent: #0f766e;
      border: 1px solid var(--tb-border);
      border-radius: 12px;
      padding: 1rem;
      background: #fff;
    }
    .tb-byob__eyebrow {
      margin: 0;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--tb-mute);
    }
    .tb-byob__heading {
      margin: 0.25rem 0 0;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--tb-fg);
    }
    .tb-byob__hint {
      margin: 0.35rem 0 0.85rem;
      font-size: 0.8rem;
      color: var(--tb-mute);
    }
    .tb-byob__slot {
      border-top: 1px solid var(--tb-border);
      padding: 0.75rem 0;
    }
    .tb-byob__slot-head {
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
      margin-bottom: 0.45rem;
    }
    .tb-byob__slot-title {
      font-size: 0.9rem;
      font-weight: 650;
    }
    .tb-byob__slot-meta {
      font-size: 0.75rem;
      color: var(--tb-mute);
      font-variant-numeric: tabular-nums;
    }
    .tb-byob__pool {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .tb-byob__pool-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      font-size: 0.85rem;
    }
    .tb-byob__pool-item--muted,
    .tb-byob__pool-item--id {
      color: var(--tb-mute);
    }
    .tb-byob__qty input {
      width: 3.5rem;
      padding: 0.25rem 0.35rem;
      border: 1px solid var(--tb-border);
      border-radius: 6px;
      font-size: 0.85rem;
    }
    .tb-byob__footer {
      border-top: 1px solid var(--tb-border);
      padding-top: 0.75rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
    }
    .tb-byob__status {
      margin: 0;
      font-size: 0.75rem;
      color: var(--tb-mute);
      flex: 1;
    }
    .tb-byob__btn {
      font-size: 0.8rem;
      font-weight: 650;
      padding: 0.45rem 0.85rem;
      border-radius: 8px;
      border: 1px solid var(--tb-border);
      background: var(--tb-soft);
      color: var(--tb-fg);
      cursor: pointer;
    }
    .tb-byob__btn--primary {
      background: var(--tb-accent);
      border-color: var(--tb-accent);
      color: #fff;
    }
    .tb-byob__btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    .tb-byob__empty {
      margin: 0;
      font-size: 0.8rem;
      color: var(--tb-mute);
    }
    .visually-hidden {
      position: absolute !important;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  {% endstyle %}
{% endif %}

{% schema %}
{
  "name": "t:blocks.byob_builder.name",
  "target": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.byob_builder.settings.heading",
      "default": "Build your bundle"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "t:blocks.byob_builder.settings.margin_top",
      "default": 12
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "t:blocks.byob_builder.settings.margin_bottom",
      "default": 16
    }
  ]
}
{% endschema %}
