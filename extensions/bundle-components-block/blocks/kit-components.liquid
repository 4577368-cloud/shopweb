{% comment %}
  Tangbuy / 60s — Kit components (Fixed Kit PDP summary)
  Metafields: tangbuy_bundle.is_kit, tangbuy_bundle.components_json, tangbuy_bundle.discount_percent
  components_json lines: title|name, quantity, imageUrl|image_url
{% endcomment %}

{% liquid
  assign is_kit = product.metafields.tangbuy_bundle.is_kit.value
  assign components = product.metafields.tangbuy_bundle.components_json.value
  assign discount_pct = product.metafields.tangbuy_bundle.discount_percent.value | default: 0 | plus: 0

  assign heading = block.settings.heading
  if heading == blank
    assign heading = 'blocks.kit_components.heading' | t
  endif

  assign list_heading = block.settings.list_heading
  if list_heading == blank
    assign list_heading = 'blocks.kit_components.list_heading' | t
  endif

  assign eyebrow = block.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'blocks.kit_components.eyebrow' | t
  endif

  assign promo = block.settings.promo_text
  assign subtext = block.settings.subtext
  assign show_media = block.settings.show_media_strip
  assign show_list = block.settings.show_included_list
  assign show_qty = block.settings.show_quantity
  assign show_summary = block.settings.show_summary_row

  assign line_count = 0
  assign total_units = 0

  if components != blank
    for line in components
      assign line_title = line.title
      if line_title == blank
        assign line_title = line.name
      endif
      assign line_qty = line.quantity | default: 1 | plus: 0
      if line_title != blank and line_title != 'null'
        assign line_count = line_count | plus: 1
        assign total_units = total_units | plus: line_qty
      endif
    endfor
  endif

  assign save_money = blank
  if promo != blank
    assign save_money = promo
  elsif discount_pct > 0
    assign price_cents = product.selected_or_first_available_variant.price | default: 0
    if price_cents > 0
      assign save_cents = price_cents | times: discount_pct | divided_by: 100.0
      if save_cents >= 1
        assign save_formatted = save_cents | money | strip_html
        assign save_money = 'blocks.kit_components.save_amount' | t: amount: save_formatted
      endif
    endif
    if save_money == blank
      assign save_money = 'blocks.kit_components.save_percent' | t: percent: discount_pct
    endif
  endif
%}

{% liquid
  assign has_multi_qty = false
  if total_units > line_count
    assign has_multi_qty = true
  endif
  assign show_summary_block = false
  if show_summary
    if has_multi_qty or discount_pct > 0
      assign show_summary_block = true
    endif
  endif
%}

{% comment %}
  Show whenever composition metafield has lines. Do not require is_kit —
  some parents only got components_json if boolean write lagged.
{% endcomment %}
{% if line_count > 0 %}
  <div
    class="tb-kit-premium"
    {{ block.shopify_attributes }}
    style="margin-top: {{ block.settings.margin_top }}px; margin-bottom: {{ block.settings.margin_bottom }}px;"
  >
    <div class="tb-kit-premium__head">
      <div class="tb-kit-premium__copy">
        <p class="tb-kit-premium__eyebrow">{{ eyebrow | escape }}</p>
        <h3 class="tb-kit-premium__title">{{ heading | escape }}</h3>
        {% if subtext != blank %}
          <p class="tb-kit-premium__subtext">{{ subtext | escape }}</p>
        {% endif %}
        {% if save_money != blank %}
          <div class="tb-kit-premium__promo-wrap">
            <span class="tb-kit-premium__promo">{{ save_money | escape }}</span>
          </div>
        {% endif %}
      </div>

      <div class="tb-kit-premium__meta">
        <span class="tb-kit-premium__badge">{{ line_count }}</span>
        <span class="tb-kit-premium__meta-label">{{ 'blocks.kit_components.items_count' | t: count: line_count }}</span>
      </div>
    </div>

    {% if show_summary_block %}
      <div class="tb-kit-premium__summary" role="list">
        {% if has_multi_qty %}
          <div class="tb-kit-premium__summary-item" role="listitem">
            <span class="tb-kit-premium__summary-value">{{ total_units }}</span>
            <span class="tb-kit-premium__summary-label">{{ 'blocks.kit_components.total_units' | t }}</span>
          </div>
          <div class="tb-kit-premium__summary-item" role="listitem">
            <span class="tb-kit-premium__summary-value">{{ line_count }}</span>
            <span class="tb-kit-premium__summary-label">{{ 'blocks.kit_components.included_products' | t }}</span>
          </div>
        {% endif %}
        {% if discount_pct > 0 %}
          <div class="tb-kit-premium__summary-item" role="listitem">
            <span class="tb-kit-premium__summary-value">{{ discount_pct }}%</span>
            <span class="tb-kit-premium__summary-label">{{ 'blocks.kit_components.bundle_discount' | t }}</span>
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if show_media %}
      <div class="tb-kit-premium__gallery" role="list" aria-label="{{ heading | escape }}">
        {% for line in components limit: 6 %}
          {% liquid
            assign line_title = line.title
            if line_title == blank
              assign line_title = line.name
            endif
            assign line_qty = line.quantity | default: 1
            assign line_image = line.imageUrl
            if line_image == blank
              assign line_image = line.image_url
            endif
          %}
          {% if line_title != blank and line_title != 'null' %}
            <div class="tb-kit-premium__gallery-item" role="listitem">
              <div class="tb-kit-premium__thumb-wrap">
                {% if line_image != blank and line_image != 'null' %}
                  <img class="tb-kit-premium__thumb" src="{{ line_image | escape }}" alt="{{ line_title | escape }}" width="88" height="88" loading="lazy">
                {% else %}
                  <div class="tb-kit-premium__thumb tb-kit-premium__thumb--placeholder" aria-hidden="true"></div>
                {% endif %}
                {% if show_qty and line_qty > 1 %}
                  <span class="tb-kit-premium__qty-pill">×{{ line_qty }}</span>
                {% endif %}
              </div>
              <p class="tb-kit-premium__thumb-title">{{ line_title | escape }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if show_list %}
      <div class="tb-kit-premium__included">
        {% if list_heading != blank %}
          <p class="tb-kit-premium__included-heading">{{ list_heading | escape }}</p>
        {% endif %}
        <ul class="tb-kit-premium__list" role="list">
          {% for line in components %}
            {% liquid
              assign line_title = line.title
              if line_title == blank
                assign line_title = line.name
              endif
              assign line_qty = line.quantity | default: 1 | plus: 0
            %}
            {% if line_title != blank and line_title != 'null' %}
              <li class="tb-kit-premium__list-item">
                <span class="tb-kit-premium__check" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M2.8 7.2 5.5 9.9 11.2 4.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="tb-kit-premium__item-text">
                  <span class="tb-kit-premium__item-title">{{ line_title | escape }}</span>
                </span>
                {% if show_qty and line_qty > 1 %}
                  <span class="tb-kit-premium__item-qty">×{{ line_qty }}</span>
                {% endif %}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </div>

  {% style %}
    .tb-kit-premium {
      --tb-kit-fg: rgb(var(--color-foreground, 18 18 18));
      --tb-kit-bg: rgb(var(--color-background, 255 255 255));
      --tb-kit-muted: color-mix(in srgb, var(--tb-kit-fg) 56%, transparent);
      --tb-kit-faint: color-mix(in srgb, var(--tb-kit-fg) 34%, transparent);
      --tb-kit-border: color-mix(in srgb, var(--tb-kit-fg) 12%, transparent);
      --tb-kit-soft: color-mix(in srgb, var(--tb-kit-fg) 4.5%, transparent);
      --tb-kit-soft-2: color-mix(in srgb, var(--tb-kit-fg) 7%, transparent);
      --tb-kit-accent: #1f6b4a;
      --tb-kit-accent-soft: color-mix(in srgb, var(--tb-kit-accent) 11%, var(--tb-kit-bg));
      border: 1px solid var(--tb-kit-border);
      border-radius: 18px;
      background: var(--tb-kit-bg);
      box-shadow:
        0 1px 2px color-mix(in srgb, var(--tb-kit-fg) 5%, transparent),
        0 10px 30px color-mix(in srgb, var(--tb-kit-fg) 4%, transparent);
      overflow: hidden;
    }

    .tb-kit-premium__head {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 1.05rem 1rem 0.95rem;
      background: linear-gradient(180deg, var(--tb-kit-soft), transparent 75%);
      border-bottom: 1px solid var(--tb-kit-border);
    }

    .tb-kit-premium__copy {
      min-width: 0;
      flex: 1;
    }

    .tb-kit-premium__eyebrow,
    .tb-kit-premium__included-heading,
    .tb-kit-premium__summary-label {
      margin: 0;
      font-size: 0.72rem;
      line-height: 1.2;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--tb-kit-muted);
    }

    .tb-kit-premium__title {
      margin: 0.28rem 0 0;
      font-size: 1.12rem;
      line-height: 1.22;
      font-weight: 700;
      color: var(--tb-kit-fg);
    }

    .tb-kit-premium__subtext {
      margin: 0.42rem 0 0;
      font-size: 0.9rem;
      line-height: 1.45;
      color: var(--tb-kit-muted);
      max-width: 44ch;
    }

    .tb-kit-premium__promo-wrap {
      margin-top: 0.6rem;
    }

    .tb-kit-premium__promo {
      display: inline-flex;
      align-items: center;
      min-height: 2rem;
      padding: 0 0.8rem;
      border-radius: 999px;
      background: var(--tb-kit-accent-soft);
      color: var(--tb-kit-accent);
      font-size: 0.82rem;
      font-weight: 700;
      line-height: 1;
    }

    .tb-kit-premium__meta {
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.3rem;
      min-width: 4.5rem;
    }

    .tb-kit-premium__badge {
      width: 2.2rem;
      height: 2.2rem;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--tb-kit-soft);
      border: 1px solid var(--tb-kit-border);
      color: var(--tb-kit-fg);
      font-size: 0.86rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }

    .tb-kit-premium__meta-label {
      font-size: 0.72rem;
      line-height: 1.25;
      text-align: center;
      color: var(--tb-kit-muted);
      max-width: 7ch;
    }

    .tb-kit-premium__summary {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
      border-bottom: 1px solid var(--tb-kit-border);
      background: color-mix(in srgb, var(--tb-kit-soft) 55%, var(--tb-kit-bg));
    }

    .tb-kit-premium__summary-item {
      padding: 0.85rem 0.9rem;
      display: flex;
      flex-direction: column;
      gap: 0.18rem;
    }

    .tb-kit-premium__summary-item + .tb-kit-premium__summary-item {
      border-left: 1px solid var(--tb-kit-border);
    }

    .tb-kit-premium__summary-value {
      font-size: 1rem;
      line-height: 1.2;
      font-weight: 700;
      color: var(--tb-kit-fg);
      font-variant-numeric: tabular-nums;
    }

    .tb-kit-premium__gallery {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(88px, 1fr));
      gap: 0.8rem;
      padding: 1rem;
      border-bottom: 1px solid var(--tb-kit-border);
      background: color-mix(in srgb, var(--tb-kit-soft) 35%, var(--tb-kit-bg));
    }

    .tb-kit-premium__gallery-item {
      min-width: 0;
      text-align: center;
    }

    .tb-kit-premium__thumb-wrap {
      position: relative;
      width: 88px;
      margin: 0 auto;
    }

    .tb-kit-premium__thumb {
      width: 88px;
      height: 88px;
      object-fit: cover;
      border-radius: 14px;
      border: 1px solid var(--tb-kit-border);
      background: var(--tb-kit-bg);
      box-shadow: 0 2px 8px color-mix(in srgb, var(--tb-kit-fg) 6%, transparent);
      display: block;
    }

    .tb-kit-premium__thumb--placeholder {
      background: linear-gradient(145deg, var(--tb-kit-soft), var(--tb-kit-soft-2));
    }

    .tb-kit-premium__qty-pill {
      position: absolute;
      right: -0.2rem;
      bottom: -0.2rem;
      min-height: 1.4rem;
      padding: 0 0.42rem;
      border-radius: 999px;
      border: 1px solid var(--tb-kit-border);
      background: var(--tb-kit-bg);
      color: var(--tb-kit-fg);
      font-size: 0.7rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 1px 4px color-mix(in srgb, var(--tb-kit-fg) 8%, transparent);
    }

    .tb-kit-premium__thumb-title {
      margin: 0.5rem 0 0;
      font-size: 0.78rem;
      line-height: 1.35;
      color: var(--tb-kit-muted);
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }

    .tb-kit-premium__included {
      padding: 0.95rem 1rem 1rem;
    }

    .tb-kit-premium__included-heading {
      margin-bottom: 0.65rem;
    }

    .tb-kit-premium__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }

    .tb-kit-premium__list-item {
      display: flex;
      align-items: flex-start;
      gap: 0.65rem;
      min-width: 0;
      padding: 0.15rem 0;
    }

    .tb-kit-premium__check {
      width: 1.25rem;
      height: 1.25rem;
      margin-top: 0.02rem;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      color: var(--tb-kit-accent);
      background: var(--tb-kit-accent-soft);
    }

    .tb-kit-premium__item-text {
      flex: 1;
      min-width: 0;
    }

    .tb-kit-premium__item-title {
      display: block;
      font-size: 0.92rem;
      line-height: 1.4;
      color: var(--tb-kit-fg);
    }

    .tb-kit-premium__item-qty {
      flex-shrink: 0;
      font-size: 0.75rem;
      line-height: 1.3;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      color: var(--tb-kit-muted);
      padding-top: 0.15rem;
    }

    @media screen and (max-width: 749px) {
      .tb-kit-premium__head {
        align-items: flex-start;
      }

      .tb-kit-premium__summary {
        grid-template-columns: 1fr;
      }

      .tb-kit-premium__summary-item + .tb-kit-premium__summary-item {
        border-left: 0;
        border-top: 1px solid var(--tb-kit-border);
      }

      .tb-kit-premium__gallery {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .tb-kit-premium__thumb-wrap,
      .tb-kit-premium__thumb {
        width: 76px;
        height: 76px;
      }
    }
  {% endstyle %}
{% elsif request.design_mode %}
  <div
    class="tb-kit-premium tb-kit-premium--editor-empty"
    {{ block.shopify_attributes }}
    style="margin-top: {{ block.settings.margin_top }}px; margin-bottom: {{ block.settings.margin_bottom }}px; padding: 1rem; border: 1px dashed #c4c4c4; border-radius: 8px; color: #6b7280; font-size: 0.875rem; line-height: 1.45;"
  >
    <p style="margin: 0 0 0.35rem; font-weight: 600; color: #111827;">
      {{ 'blocks.kit_components.name' | t }}
    </p>
    <p style="margin: 0;">
      {{ 'blocks.kit_components.editor_empty_hint' | t }}
    </p>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:blocks.kit_components.name",
  "target": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:blocks.kit_components.settings.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.kit_components.settings.heading",
      "default": "Complete Your Bundle"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "t:blocks.kit_components.settings.subtext",
      "default": "Everything in this kit is selected to work together as a complete set."
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "t:blocks.kit_components.settings.promo_text",
      "info": "t:blocks.kit_components.settings.promo_text_info"
    },
    {
      "type": "text",
      "id": "list_heading",
      "label": "t:blocks.kit_components.settings.list_heading",
      "default": "Included items"
    },
    {
      "type": "checkbox",
      "id": "show_summary_row",
      "label": "t:blocks.kit_components.settings.show_summary_row",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_media_strip",
      "label": "t:blocks.kit_components.settings.show_media_strip",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_included_list",
      "label": "t:blocks.kit_components.settings.show_included_list",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "t:blocks.kit_components.settings.show_quantity",
      "default": true
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "t:blocks.kit_components.settings.margin_top",
      "default": 12
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "t:blocks.kit_components.settings.margin_bottom",
      "default": 16
    }
  ]
}
{% endschema %}
