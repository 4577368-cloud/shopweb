{% comment %}
  Tangbuy / 60s — Kit / Bundle conversion card (Track A Fixed Kit).
  Metafields: tangbuy_bundle.is_kit, components_json, discount_percent
  Layout: value header → media strip → included checklist
  Place under title/price, above Buy buttons. Non-kit products render nothing.
{% endcomment %}

{% liquid
  assign is_kit = product.metafields.tangbuy_bundle.is_kit.value
  assign components = product.metafields.tangbuy_bundle.components_json.value
  assign discount_pct = product.metafields.tangbuy_bundle.discount_percent.value | default: 0 | plus: 0
  assign show_media = block.settings.show_media_strip
  assign show_list = block.settings.show_included_list
  assign show_qty = block.settings.show_quantity
  assign heading = block.settings.heading
  if heading == blank
    assign heading = 'blocks.kit_components.heading' | t
  endif
  assign list_heading = block.settings.list_heading
  if list_heading == blank
    assign list_heading = 'blocks.kit_components.list_heading' | t
  endif
  assign promo = block.settings.promo_text
  assign line_count = 0
  if components != blank
    for line in components
      assign probe_title = line.title
      if probe_title == blank
        assign probe_title = line.name
      endif
      if probe_title != blank and probe_title != 'null'
        assign line_count = line_count | plus: 1
      endif
    endfor
  endif

  assign save_money = blank
  if promo != blank
    assign save_money = promo
  elsif discount_pct > 0
    assign price_cents = product.selected_or_first_available_variant.price | default: 0
    if price_cents > 0
      assign save_cents = price_cents | times: discount_pct | divided_by: 100.0
      if save_cents >= 1
        assign save_formatted = save_cents | money | strip_html
        assign save_money = 'blocks.kit_components.save_amount' | t: amount: save_formatted
      endif
    endif
    if save_money == blank
      assign save_money = 'blocks.kit_components.save_percent' | t: percent: discount_pct
    endif
  endif
%}

{% if is_kit and line_count > 0 %}
  <div
    class="tb-bundle"
    {{ block.shopify_attributes }}
    style="
      margin-top: {{ block.settings.margin_top }}px;
      margin-bottom: {{ block.settings.margin_bottom }}px;
    "
  >
    <div class="tb-bundle__hero">
      <div class="tb-bundle__hero-text">
        <p class="tb-bundle__eyebrow">{{ 'blocks.kit_components.eyebrow' | t }}</p>
        <p class="tb-bundle__heading">{{ heading | escape }}</p>
        {% if save_money != blank %}
          <p class="tb-bundle__promo">{{ save_money | escape }}</p>
        {% endif %}
      </div>
      <span class="tb-bundle__count" aria-label="{{ line_count }}">{{ line_count }}</span>
    </div>

    {% if show_media %}
      <div class="tb-bundle__media" role="list">
        {% for line in components %}
          {% liquid
            assign line_title = line.title
            if line_title == blank
              assign line_title = line.name
            endif
            assign line_qty = line.quantity | default: 1
            assign line_image = line.imageUrl
            if line_image == blank
              assign line_image = line.image_url
            endif
          %}
          {% if line_title != blank and line_title != 'null' %}
            <div class="tb-bundle__media-item" role="listitem">
              <span class="tb-bundle__media-thumb" aria-hidden="true">
                {% if line_image != blank and line_image != 'null' %}
                  <img src="{{ line_image | escape }}" alt="" width="72" height="72" loading="lazy">
                {% else %}
                  <span class="tb-bundle__media-fallback"></span>
                {% endif %}
              </span>
              {% if show_qty %}
                <span class="tb-bundle__media-qty">+{{ line_qty }}</span>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if show_list %}
      <div class="tb-bundle__included">
        {% if list_heading != blank %}
          <p class="tb-bundle__included-heading">{{ list_heading | escape }}</p>
        {% endif %}
        <ul class="tb-bundle__checklist" role="list">
          {% for line in components %}
            {% liquid
              assign line_title = line.title
              if line_title == blank
                assign line_title = line.name
              endif
              assign line_qty = line.quantity | default: 1
            %}
            {% if line_title != blank and line_title != 'null' %}
              <li class="tb-bundle__check-item">
                <span class="tb-bundle__check" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M2.2 6.2 4.6 8.6 9.8 3.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="tb-bundle__check-title">{{ line_title | escape }}</span>
                {% if show_qty and line_qty > 1 %}
                  <span class="tb-bundle__check-qty">×{{ line_qty }}</span>
                {% endif %}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </div>

  {% style %}
    .tb-bundle {
      --tb-fg: rgb(var(--color-foreground, 18 18 18));
      --tb-bg: rgb(var(--color-background, 255 255 255));
      --tb-border: color-mix(in srgb, var(--tb-fg) 12%, transparent);
      --tb-mute: color-mix(in srgb, var(--tb-fg) 56%, transparent);
      --tb-soft: color-mix(in srgb, var(--tb-fg) 4.5%, transparent);
      --tb-accent: #1f6b4a;
      --tb-accent-soft: color-mix(in srgb, var(--tb-accent) 12%, var(--tb-bg));
      border: 1px solid var(--tb-border);
      border-radius: 14px;
      background: var(--tb-bg);
      box-shadow: 0 1px 0 color-mix(in srgb, var(--tb-fg) 5%, transparent);
      overflow: hidden;
    }
    .tb-bundle__hero {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.95rem 1rem 0.85rem;
      background:
        linear-gradient(180deg, var(--tb-soft), transparent 70%);
      border-bottom: 1px solid var(--tb-border);
    }
    .tb-bundle__hero-text {
      flex: 1;
      min-width: 0;
    }
    .tb-bundle__eyebrow {
      margin: 0 0 0.2rem;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--tb-mute);
    }
    .tb-bundle__heading {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 700;
      line-height: 1.25;
      color: var(--tb-fg);
    }
    .tb-bundle__promo {
      margin: 0.35rem 0 0;
      font-size: 0.875rem;
      font-weight: 650;
      line-height: 1.3;
      color: var(--tb-accent);
    }
    .tb-bundle__count {
      flex-shrink: 0;
      min-width: 1.5rem;
      height: 1.5rem;
      padding: 0 0.4rem;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.72rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      color: var(--tb-mute);
      background: var(--tb-soft);
      border: 1px solid var(--tb-border);
    }
    .tb-bundle__media {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.85rem 1rem;
      padding: 1rem 1rem 0.85rem;
      border-bottom: 1px solid var(--tb-border);
      background: color-mix(in srgb, var(--tb-soft) 65%, var(--tb-bg));
    }
    .tb-bundle__media-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
      width: 72px;
    }
    .tb-bundle__media-thumb {
      width: 72px;
      height: 72px;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--tb-border);
      background: var(--tb-bg);
      box-shadow: 0 1px 2px color-mix(in srgb, var(--tb-fg) 6%, transparent);
    }
    .tb-bundle__media-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .tb-bundle__media-fallback {
      display: block;
      width: 100%;
      height: 100%;
      background: linear-gradient(145deg, var(--tb-soft), color-mix(in srgb, var(--tb-fg) 10%, transparent));
    }
    .tb-bundle__media-qty {
      font-size: 0.72rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      color: var(--tb-mute);
      letter-spacing: 0.02em;
    }
    .tb-bundle__included {
      padding: 0.85rem 1rem 1rem;
    }
    .tb-bundle__included-heading {
      margin: 0 0 0.55rem;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--tb-mute);
    }
    .tb-bundle__checklist {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
    }
    .tb-bundle__check-item {
      display: flex;
      align-items: flex-start;
      gap: 0.55rem;
      min-width: 0;
    }
    .tb-bundle__check {
      width: 1.15rem;
      height: 1.15rem;
      margin-top: 0.05rem;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      color: var(--tb-accent);
      background: var(--tb-accent-soft);
    }
    .tb-bundle__check-title {
      flex: 1;
      min-width: 0;
      font-size: 0.9rem;
      line-height: 1.35;
      color: var(--tb-fg);
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }
    .tb-bundle__check-qty {
      flex-shrink: 0;
      font-size: 0.75rem;
      font-weight: 650;
      font-variant-numeric: tabular-nums;
      color: var(--tb-mute);
    }
  {% endstyle %}
{% endif %}

{% schema %}
{
  "name": "t:blocks.kit_components.name",
  "target": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.kit_components.settings.heading",
      "default": "Complete Your Bundle"
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "t:blocks.kit_components.settings.promo_text",
      "info": "t:blocks.kit_components.settings.promo_text_info",
      "default": ""
    },
    {
      "type": "text",
      "id": "list_heading",
      "label": "t:blocks.kit_components.settings.list_heading",
      "default": "Included items"
    },
    {
      "type": "checkbox",
      "id": "show_media_strip",
      "label": "t:blocks.kit_components.settings.show_media_strip",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_included_list",
      "label": "t:blocks.kit_components.settings.show_included_list",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "t:blocks.kit_components.settings.show_quantity",
      "default": true
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "t:blocks.kit_components.settings.margin_top",
      "default": 12
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "t:blocks.kit_components.settings.margin_bottom",
      "default": 16
    }
  ]
}
{% endschema %}
