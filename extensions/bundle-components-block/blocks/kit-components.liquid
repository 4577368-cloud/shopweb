{% comment %}
  Tangbuy / 60s — Fixed Kit composition (Track A).
  Metafields: tangbuy_bundle.is_kit + tangbuy_bundle.components_json
  Place under title/price, above Buy buttons. Non-kit products render nothing.
{% endcomment %}

{% liquid
  assign is_kit = product.metafields.tangbuy_bundle.is_kit.value
  assign components = product.metafields.tangbuy_bundle.components_json.value
  assign show_qty = block.settings.show_quantity
  assign show_thumbs = block.settings.show_thumbnails
  assign heading = block.settings.heading
  if heading == blank
    assign heading = 'blocks.kit_components.heading' | t
  endif
  assign line_count = 0
  if components != blank
    for line in components
      assign probe_title = line.title
      if probe_title == blank
        assign probe_title = line.name
      endif
      if probe_title != blank and probe_title != 'null'
        assign line_count = line_count | plus: 1
      endif
    endfor
  endif
%}

{% if is_kit and line_count > 0 %}
  <div
    class="tb-kit"
    {{ block.shopify_attributes }}
    style="
      --tb-kit-gap: {{ block.settings.gap }}px;
      margin-top: {{ block.settings.margin_top }}px;
      margin-bottom: {{ block.settings.margin_bottom }}px;
    "
  >
    <div class="tb-kit__head">
      <span class="tb-kit__mark" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <rect x="1.5" y="3" width="5.5" height="5.5" rx="1.2" stroke="currentColor" stroke-width="1.4"/>
          <rect x="9" y="3" width="5.5" height="5.5" rx="1.2" stroke="currentColor" stroke-width="1.4"/>
          <rect x="1.5" y="10.5" width="13" height="3" rx="1" stroke="currentColor" stroke-width="1.4"/>
        </svg>
      </span>
      {% if heading != blank %}
        <p class="tb-kit__heading">{{ heading | escape }}</p>
      {% endif %}
      <span class="tb-kit__count">{{ line_count }}</span>
    </div>

    <ul class="tb-kit__list" role="list">
      {% for line in components %}
        {% liquid
          assign line_title = line.title
          if line_title == blank
            assign line_title = line.name
          endif
          assign line_qty = line.quantity | default: 1
          assign line_image = line.imageUrl
          if line_image == blank
            assign line_image = line.image_url
          endif
        %}
        {% if line_title != blank and line_title != 'null' %}
          <li class="tb-kit__item">
            {% if show_thumbs %}
              <span class="tb-kit__thumb" aria-hidden="true">
                {% if line_image != blank and line_image != 'null' %}
                  <img
                    src="{{ line_image | escape }}"
                    alt=""
                    width="52"
                    height="52"
                    loading="lazy"
                  >
                {% else %}
                  <span class="tb-kit__thumb-fallback"></span>
                {% endif %}
              </span>
            {% endif %}
            <span class="tb-kit__title">{{ line_title | escape }}</span>
            {% if show_qty %}
              <span class="tb-kit__qty">×{{ line_qty }}</span>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>

  {% style %}
    .tb-kit {
      --tb-kit-fg: rgb(var(--color-foreground, 18 18 18));
      --tb-kit-border: color-mix(in srgb, var(--tb-kit-fg) 12%, transparent);
      --tb-kit-mute: color-mix(in srgb, var(--tb-kit-fg) 58%, transparent);
      --tb-kit-soft: color-mix(in srgb, var(--tb-kit-fg) 4%, transparent);
      --tb-kit-accent: color-mix(in srgb, var(--tb-kit-fg) 88%, #c45c26 12%);
      border: 1px solid var(--tb-kit-border);
      border-radius: 12px;
      background:
        linear-gradient(180deg, var(--tb-kit-soft), transparent 42%),
        rgb(var(--color-background, 255 255 255));
      box-shadow: 0 1px 0 color-mix(in srgb, var(--tb-kit-fg) 4%, transparent);
      overflow: hidden;
    }
    .tb-kit__head {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.7rem 0.9rem;
      border-bottom: 1px solid var(--tb-kit-border);
    }
    .tb-kit__mark {
      display: inline-flex;
      color: var(--tb-kit-accent);
      flex-shrink: 0;
    }
    .tb-kit__heading {
      margin: 0;
      flex: 1;
      min-width: 0;
      font-size: 0.8125rem;
      font-weight: 650;
      letter-spacing: 0.02em;
      line-height: 1.2;
      color: var(--tb-kit-fg);
    }
    .tb-kit__count {
      flex-shrink: 0;
      min-width: 1.35rem;
      height: 1.35rem;
      padding: 0 0.35rem;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.7rem;
      font-weight: 650;
      font-variant-numeric: tabular-nums;
      color: var(--tb-kit-mute);
      background: var(--tb-kit-soft);
      border: 1px solid var(--tb-kit-border);
    }
    .tb-kit__list {
      list-style: none;
      margin: 0;
      padding: 0.35rem 0;
      display: flex;
      flex-direction: column;
      gap: var(--tb-kit-gap, 0px);
    }
    .tb-kit__item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-width: 0;
      padding: 0.55rem 0.9rem;
    }
    .tb-kit__item + .tb-kit__item {
      border-top: 1px solid color-mix(in srgb, var(--tb-kit-fg) 7%, transparent);
    }
    .tb-kit__thumb {
      width: 52px;
      height: 52px;
      flex-shrink: 0;
      border-radius: 9px;
      overflow: hidden;
      background: var(--tb-kit-soft);
      border: 1px solid var(--tb-kit-border);
    }
    .tb-kit__thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .tb-kit__thumb-fallback {
      display: block;
      width: 100%;
      height: 100%;
      background:
        linear-gradient(135deg, var(--tb-kit-soft), color-mix(in srgb, var(--tb-kit-fg) 10%, transparent));
    }
    .tb-kit__title {
      flex: 1;
      min-width: 0;
      font-size: 0.875rem;
      line-height: 1.35;
      color: var(--tb-kit-fg);
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }
    .tb-kit__qty {
      flex-shrink: 0;
      padding: 0.2rem 0.5rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 650;
      font-variant-numeric: tabular-nums;
      color: var(--tb-kit-mute);
      background: var(--tb-kit-soft);
      border: 1px solid var(--tb-kit-border);
    }
  {% endstyle %}
{% endif %}

{% schema %}
{
  "name": "t:blocks.kit_components.name",
  "target": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.kit_components.settings.heading",
      "default": "本套装包含"
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "t:blocks.kit_components.settings.show_quantity",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_thumbnails",
      "label": "t:blocks.kit_components.settings.show_thumbnails",
      "default": true,
      "info": "t:blocks.kit_components.settings.show_thumbnails_info"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 16,
      "step": 2,
      "unit": "px",
      "label": "t:blocks.kit_components.settings.gap",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "t:blocks.kit_components.settings.margin_top",
      "default": 12
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "t:blocks.kit_components.settings.margin_bottom",
      "default": 16
    }
  ]
}
{% endschema %}
