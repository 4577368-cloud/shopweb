{% comment %}
  Tangbuy / 60s — Fixed Kit composition (Track A).
  Reads product metafields tangbuy_bundle.is_kit + tangbuy_bundle.components_json.
  Non-kit products render nothing. Place this block under title/price (or above Buy buttons).
{% endcomment %}

{% liquid
  assign is_kit = product.metafields.tangbuy_bundle.is_kit.value
  assign components = product.metafields.tangbuy_bundle.components_json.value
  assign show_qty = block.settings.show_quantity
  assign show_thumbs = block.settings.show_thumbnails
  assign heading = block.settings.heading
  if heading == blank
    assign heading = 'blocks.kit_components.heading' | t
  endif
%}

{% if is_kit and components != blank %}
  <div
    class="tangbuy-kit-components"
    {{ block.shopify_attributes }}
    style="
      --tkc-gap: {{ block.settings.gap }}px;
      margin-top: {{ block.settings.margin_top }}px;
      margin-bottom: {{ block.settings.margin_bottom }}px;
    "
  >
    {% if heading != blank %}
      <p class="tangbuy-kit-components__heading">{{ heading | escape }}</p>
    {% endif %}

    <ul class="tangbuy-kit-components__list" role="list">
      {% for line in components %}
        {% liquid
          assign line_title = line.title
          if line_title == blank
            assign line_title = line.name
          endif
          assign line_qty = line.quantity | default: 1
          assign line_image = line.imageUrl
          if line_image == blank
            assign line_image = line.image_url
          endif
        %}
        {% if line_title != blank and line_title != 'null' %}
          <li class="tangbuy-kit-components__item">
            {% if show_thumbs %}
              <span class="tangbuy-kit-components__thumb-wrap" aria-hidden="true">
                {% if line_image != blank and line_image != 'null' %}
                  <img
                    class="tangbuy-kit-components__thumb"
                    src="{{ line_image | escape }}"
                    alt=""
                    width="48"
                    height="48"
                    loading="lazy"
                  >
                {% endif %}
              </span>
            {% endif %}
            <span class="tangbuy-kit-components__title">{{ line_title | escape }}</span>
            {% if show_qty %}
              <span class="tangbuy-kit-components__qty">×{{ line_qty }}</span>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>

  {% style %}
    .tangbuy-kit-components {
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 10px;
      padding: 0.85rem 1rem;
      background: rgba(0, 0, 0, 0.02);
    }
    .tangbuy-kit-components__heading {
      margin: 0 0 0.65rem;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      opacity: 0.72;
    }
    .tangbuy-kit-components__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: var(--tkc-gap, 8px);
    }
    .tangbuy-kit-components__item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-width: 0;
      font-size: 0.9rem;
      line-height: 1.35;
    }
    .tangbuy-kit-components__thumb-wrap {
      width: 48px;
      height: 48px;
      flex-shrink: 0;
      border-radius: 8px;
      overflow: hidden;
      background: rgba(0, 0, 0, 0.04);
      border: 1px solid rgba(0, 0, 0, 0.06);
    }
    .tangbuy-kit-components__thumb {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .tangbuy-kit-components__title {
      flex: 1;
      min-width: 0;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }
    .tangbuy-kit-components__qty {
      flex-shrink: 0;
      opacity: 0.65;
      font-variant-numeric: tabular-nums;
      font-size: 0.85rem;
    }
  {% endstyle %}
{% endif %}

{% schema %}
{
  "name": "t:blocks.kit_components.name",
  "target": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.kit_components.settings.heading",
      "default": "This kit includes"
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "t:blocks.kit_components.settings.show_quantity",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_thumbnails",
      "label": "t:blocks.kit_components.settings.show_thumbnails",
      "default": true,
      "info": "t:blocks.kit_components.settings.show_thumbnails_info"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "t:blocks.kit_components.settings.gap",
      "default": 8
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "t:blocks.kit_components.settings.margin_top",
      "default": 12
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "t:blocks.kit_components.settings.margin_bottom",
      "default": 12
    }
  ]
}
{% endschema %}
